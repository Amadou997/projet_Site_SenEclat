# Copier ce fichier en `.env` puis adapter les valeurs.
DJANGO_DEBUG=true
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de données (SQLite par défaut ; PostgreSQL en production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=sen_eclat
# DB_USER=sen_eclat
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# true en production (HTTPS obligatoire). Par défaut : true si DJANGO_DEBUG=false.
JWT_COOKIE_SECURE=false

# Métier
DELIVERY_FEE_DAKAR=2000
FCFA_PER_LOYALTY_POINT=1000

# Administrateur créé par `python manage.py seed` (développement uniquement)
SEED_ADMIN_EMAIL=admin@seneclat.test
SEED_ADMIN_PASSWORD=

# Dossier des images produits téléversées (à servir sous /media/ par le serveur web en production)
# DJANGO_MEDIA_ROOT=/var/www/sen-eclat/media
